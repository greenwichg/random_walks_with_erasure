{
  "compilerOptions": {
    // ES2022 and NO "DOM". This is the load-bearing line in this file: without it `document` and
    // `window` are declared globals and type-check happily, and the only thing standing between the
    // shared core and a browser dependency is a regex in a test. With it, the compiler refuses
    // first, at the point of writing, with the name of the identifier.
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // No "jsx": a .tsx file in this package is a mistake, and the guard test says so too.
    "types": []
  },
  // Source only. Tests get tsconfig.test.json, which adds Node types — a test may import node:fs
  // and reference `process`; a shipped module may not, and one config for both would grant the
  // shipped modules everything the tests need.
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
