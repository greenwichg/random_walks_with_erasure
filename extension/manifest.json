{
  "manifest_version": 3,
  "name": "InfoDiet \u2014 Information Health",
  "version": "0.1.0",
  "description": "Privately syncs the news articles you read on supported sites to your InfoDiet account \u2014 URL and standard metadata only.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "InfoDiet \u2014 Information Health",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "run_at": "document_idle",
      "js": [
        "common.js",
        "content.js"
      ],
      "matches": [
        "https://*.nytimes.com/*",
        "https://*.washingtonpost.com/*",
        "https://*.wsj.com/*",
        "https://*.foxnews.com/*",
        "https://*.cnn.com/*",
        "https://*.nbcnews.com/*",
        "https://*.apnews.com/*",
        "https://*.reuters.com/*",
        "https://*.npr.org/*",
        "https://*.bbc.com/*",
        "https://*.bbc.co.uk/*",
        "https://*.theguardian.com/*",
        "https://*.politico.com/*",
        "https://*.thehill.com/*",
        "https://*.usatoday.com/*",
        "https://*.cnbc.com/*",
        "https://*.bloomberg.com/*",
        "https://abcnews.go.com/*",
        "https://*.cbsnews.com/*",
        "https://*.aljazeera.com/*",
        "https://*.axios.com/*",
        "https://*.vox.com/*",
        "https://*.theatlantic.com/*",
        "https://*.latimes.com/*"
      ]
    }
  ]
}
