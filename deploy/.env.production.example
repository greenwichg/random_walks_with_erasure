# Production environment TEMPLATE for the AWS EC2 closed beta (Wave 0). DEPLOYMENT-ONLY.
#
#   cp deploy/.env.production.example deploy/.env
#   $EDITOR deploy/.env        # fill every REQUIRED value below
#   chmod 600 deploy/.env      # secrets — owner-read-only
#
# This file is COMMITTED and MUST stay secret-free (placeholders only). The filled-in deploy/.env is
# git-ignored (see .gitignore). deploy/docker-compose.aws.yml reads these via ${VAR}; the host-side
# ops scripts (deploy/ops/*) read the same file. Values with a real default are marked (optional).
#
# Generate strong secrets with:  openssl rand -base64 32

# ── Domain & TLS (Caddy) ───────────────────────────────────────────────────────────────────────────
APP_DOMAIN=hidden-view.com                 # REQUIRED — apex served; www.<domain> redirects to it
ACME_EMAIL=ops@hidden-view.com             # REQUIRED — Let's Encrypt account email (expiry notices)

# ── Host data directory (bind-mounted to /app/data; holds the SQLite DB + backups) ─────────────────
IH_DATA_DIR=/opt/ih/data                   # (optional) default /opt/ih/data — created by bootstrap-ec2.sh
IH_DATA_MOUNT=0                            # 0 = data on the ROOT EBS volume (default, no separate mount).
                                           # 1 = data on a DEDICATED EBS volume mounted at IH_DATA_DIR:
                                           #     deploy refuses to start unless it is actually mounted, so a
                                           #     boot-before-mount race can't create a fresh EMPTY database.

# ── Engine (FastAPI) — fail-closed production auth ─────────────────────────────────────────────────
RWE_ENV=production                         # REQUIRED — enables fail-closed auth on both tiers
RWE_INTERNAL_SECRET=                       # REQUIRED — openssl rand -base64 32; IDENTICAL on api + web
RWE_DB_URL=sqlite:////app/data/ih_beta.db  # (optional) persistent DB path on the mounted volume
RWE_BACKEND_URL=http://api:8000            # (optional) web → engine origin on the Docker network

# ── Feature flags (engine) ─────────────────────────────────────────────────────────────────────────
RWE_COACH_V2=0                             # (optional) 1 = M6 coach v2 (intent-routed replies, weekly
                                           #   recap, trigger-ladder greeting) for MEASURED readers.
                                           #   0 = v1 grounded narrator (default). Demo path is always v1.

# ── GDELT ingestion (keyless second source; adapter already registered) — CONTROLLED TRIAL ──────────
# Wired but DISABLED by default. Enable a controlled trial per docs/GDELT_TRIAL_RUNBOOK.md. GDELT is
# high-volume + mostly unknown-outlet: those articles stay SEARCHABLE but are NOT recommendable (no-lean
# rows drop from the recommendation corpus — docs/CORPUS_ARCHITECTURE.md). Set RETENTION before enabling.
RWE_GDELT_ENABLED=0                         # 1 = poll GDELT (keyless). Default 0 (off).
# RWE_GDELT_QUERY=                          # (optional) override the built-in topic query; unset = default
RWE_GDELT_MAX_ARTICLES=25                   # per-poll cap (adapter default 75) — conservative
RWE_GDELT_POLL_INTERVAL=1800               # seconds between polls (adapter default 900) — 30 min, conservative
RWE_GDELT_GKG=1                             # GKG event-geography enricher (keyless) — the supply behind
                                           #   the event-location Country filter. ON at launch; set 0 to
                                           #   kill (pickers then stay empty — honest, never wrong).
# RWE_GDELT_GKG_INTERVAL=900               # (optional) seconds between GKG cycles; GKG publishes every 15 min
# RWE_GDELT_GKG_WINDOWS=4                  # (optional) steady-state 15-min windows per cycle (default 4 = 1 h).
# RWE_GDELT_GKG_BACKFILL_WINDOWS=96        # (optional) cold-start depth, AUTOMATIC on the first cycle over a
                                           #   barely-located catalog (default 96 = 24 h; 0 = disable).
# RWE_GDELT_GKG_BACKFILL_THRESHOLD=25       # (optional) "barely located" = fewer stored event rows than this.

# NewsAPI (additional source on the SAME pipeline — dedup/scoring/registry/clustering shared).
# Free-tier budget math: ~100 requests/day; the 900 s interval spends 96/day at one request per
# cycle. CATEGORY/COUNTRY/LANGUAGE take comma-separated lists polled by ROTATION (one combination
# per cycle), so lists change coverage breadth, never the request rate.
# RWE_NEWSAPI_ENABLED=1                    # enable (requires the API key below)
# RWE_NEWSAPI_API_KEY=                     # REQUIRED when enabled — https://newsapi.org
# RWE_NEWSAPI_POLL_INTERVAL=900            # (optional) seconds between cycles
# RWE_NEWSAPI_ENDPOINT=top-headlines       # (optional) top-headlines | everything
# RWE_NEWSAPI_QUERY=                       # (optional) free-text q applied to every combination
# RWE_NEWSAPI_CATEGORY=                    # (optional) e.g. business,technology (rotated)
# RWE_NEWSAPI_COUNTRY=                     # (optional) e.g. us,gb (rotated)
# RWE_NEWSAPI_LANGUAGE=                    # (optional) e.g. en (rotated; mainly for `everything`)
# RWE_NEWSAPI_PAGE_SIZE=100                # (optional) articles per request, 1..100
# RWE_NEWSAPI_MAX_ARTICLES=                # (optional) ingest quota per cycle (post-fetch cap)
# RWE_NEWSAPI_DAILY_BUDGET=90              # (optional) per-UTC-day request cap, 0 = unlimited;
                                           #   spent budget SKIPS cycles (logged, budgetExhausted)

# Six additional providers (2026-07) — same pipeline, same chassis semantics as NewsAPI (comma
# lists rotated one combination per cycle; DAILY_BUDGET short-circuits before any request; 429s
# counted on health aggregates). All default OFF. Free-tier budget math per provider:
#   Guardian   ~500 req/day  → 900 s spends 96;  budget default 450 (developer key, generous)
#   NewsData   ~200 credits/day, size ≤ 10 free → 900 s spends 96; budget default 190
#   GNews      ~100 req/day, max ≤ 10 free      → 900 s spends 96; budget default 95
#   MediaStack 100 req/MONTH (verified 2026-07) → 28800 s spends 3/day; budget default 3
#   Currents   ~600 req/day                     → 900 s spends 96; budget default 550
#   GoogleNews keyless RSS                      → 900 s, one feed per cycle (be polite)
#
# The Guardian Open Platform — https://open-platform.theguardian.com/access/
# RWE_GUARDIAN_ENABLED=1                   # enable (requires the API key below)
# RWE_GUARDIAN_API_KEY=                    # REQUIRED when enabled
# RWE_GUARDIAN_POLL_INTERVAL=900           # (optional) seconds between cycles
# RWE_GUARDIAN_SECTION=                    # (optional) e.g. world,politics (rotated)
# RWE_GUARDIAN_QUERY=                      # (optional) free-text q applied to every combination
# RWE_GUARDIAN_PAGE_SIZE=50                # (optional) articles per request, 1..50
# RWE_GUARDIAN_MAX_ARTICLES=               # (optional) ingest quota per cycle (post-fetch cap)
# RWE_GUARDIAN_DAILY_BUDGET=450            # (optional) per-UTC-day request cap, 0 = unlimited
#
# NewsData.io — https://newsdata.io
# RWE_NEWSDATA_ENABLED=1                   # enable (requires the API key below)
# RWE_NEWSDATA_API_KEY=                    # REQUIRED when enabled
# RWE_NEWSDATA_POLL_INTERVAL=900           # (optional) seconds between cycles
# RWE_NEWSDATA_QUERY=                      # (optional) free-text q
# RWE_NEWSDATA_CATEGORY=                   # (optional) e.g. technology,business (rotated)
# RWE_NEWSDATA_COUNTRY=                    # (optional) e.g. us,gb (rotated)
# RWE_NEWSDATA_LANGUAGE=                   # (optional) e.g. en (rotated)
# RWE_NEWSDATA_PAGE_SIZE=10                # (optional) 1..50 — the FREE tier caps size at 10
# RWE_NEWSDATA_MAX_ARTICLES=               # (optional) ingest quota per cycle
# RWE_NEWSDATA_DAILY_BUDGET=190            # (optional) per-UTC-day request cap, 0 = unlimited
#
# GNews — https://gnews.io
# RWE_GNEWS_ENABLED=1                      # enable (requires the API key below)
# RWE_GNEWS_API_KEY=                       # REQUIRED when enabled
# RWE_GNEWS_POLL_INTERVAL=900              # (optional) seconds between cycles
# RWE_GNEWS_QUERY=                         # (optional) free-text q
# RWE_GNEWS_CATEGORY=                      # (optional) e.g. general,world (rotated)
# RWE_GNEWS_COUNTRY=                       # (optional) e.g. us,gb (rotated)
# RWE_GNEWS_LANGUAGE=                      # (optional) e.g. en (rotated; GNews param `lang`)
# RWE_GNEWS_PAGE_SIZE=10                   # (optional) 1..100 — the FREE tier caps max at 10
# RWE_GNEWS_MAX_ARTICLES=                  # (optional) ingest quota per cycle
# RWE_GNEWS_DAILY_BUDGET=95                # (optional) per-UTC-day request cap, 0 = unlimited
#
# MediaStack — https://mediastack.com  (MONTHLY free quota of 100 — verified on the operator
# dashboard 2026-07-26; keep the long interval + tiny budget. NOTE every api restart runs one
# immediate cycle, which spends one MediaStack request from the daily budget.)
# RWE_MEDIASTACK_ENABLED=1                 # enable (requires the API key below)
# RWE_MEDIASTACK_API_KEY=                  # REQUIRED when enabled
# RWE_MEDIASTACK_POLL_INTERVAL=28800       # (optional) 8 h default — 3 cycles/day
# RWE_MEDIASTACK_HTTPS=1                   # (optional) HTTPS is PAID-only on MediaStack; set 0 to
                                           #   use http on the free tier (documented trade-off:
                                           #   article metadata then transits unencrypted)
# RWE_MEDIASTACK_QUERY=                    # (optional) keywords
# RWE_MEDIASTACK_CATEGORY=                 # (optional) e.g. general,business (rotated)
# RWE_MEDIASTACK_COUNTRY=                  # (optional) e.g. us,gb (rotated)
# RWE_MEDIASTACK_LANGUAGE=                 # (optional) e.g. en (rotated)
# RWE_MEDIASTACK_PAGE_SIZE=100             # (optional) articles per request, 1..100
# RWE_MEDIASTACK_MAX_ARTICLES=             # (optional) ingest quota per cycle
# RWE_MEDIASTACK_DAILY_BUDGET=3            # (optional) per-UTC-day request cap — 3/day ≈ 93/month
#
# Currents — https://currentsapi.services
# RWE_CURRENTS_ENABLED=1                   # enable (requires the API key below)
# RWE_CURRENTS_API_KEY=                    # REQUIRED when enabled
# RWE_CURRENTS_POLL_INTERVAL=900           # (optional) seconds between cycles
# RWE_CURRENTS_QUERY=                      # (optional) keywords
# RWE_CURRENTS_CATEGORY=                   # (optional) e.g. world,technology (rotated)
# RWE_CURRENTS_COUNTRY=                    # (optional) e.g. US,GB (rotated)
# RWE_CURRENTS_LANGUAGE=                   # (optional) e.g. en (rotated)
# RWE_CURRENTS_PAGE_SIZE=20                # (optional) 1..100 — the FREE tier caps page_size at 20
                                           #   (verified in prod 2026-07-26: 21+ is a hard 400)
# RWE_CURRENTS_MAX_ARTICLES=               # (optional) ingest quota per cycle
# RWE_CURRENTS_DAILY_BUDGET=550            # (optional) per-UTC-day request cap, 0 = unlimited
#
# Google News RSS (keyless — no key, no budget; one feed fetched per cycle, rotated).
# NOTE item links are Google redirect URLs: the Read flow opens via Google's redirect, and
# canonical dedup cannot merge a Google-delivered copy with the publisher's own-feed copy
# (story clustering still groups them by title). Publisher identity comes from the item's
# <source> tag and resolves through the outlet registry like every other source.
# RWE_GOOGLENEWS_ENABLED=1                 # enable (no key needed)
# RWE_GOOGLENEWS_POLL_INTERVAL=900         # (optional) seconds between cycles
# RWE_GOOGLENEWS_TOPICS=                   # (optional) ⊆ WORLD,NATION,BUSINESS,TECHNOLOGY,
                                           #   ENTERTAINMENT,SPORTS,SCIENCE,HEALTH (rotated)
# RWE_GOOGLENEWS_QUERIES=                  # (optional) free-text searches (rotated with TOPICS)
# RWE_GOOGLENEWS_LANGUAGE=en-US            # (optional) feed locale `hl`
# RWE_GOOGLENEWS_COUNTRY=US                # (optional) feed locale `gl`
# RWE_GOOGLENEWS_MAX_ARTICLES=             # (optional) ingest quota per cycle
RWE_RETENTION_MAX_COUNT=150000              # catalog cap (~30 days of ingestion; DB steadies ~460 MB).
                                           #   0 = OFF/unbounded. REQUIRED non-zero whenever
                                           #   RWE_GDELT_ENABLED=1. See docs/STORAGE_LIFECYCLE.md.
# --- storage lifecycle (examples/retention_policy.py). 0 = keep forever, everywhere. -------------
# USER DATA (reads, saves, settings, accounts) has NO policy and is never pruned.
# RWE_RETENTION_MAX_AGE_DAYS=0             # (optional) also prune catalog articles older than N days
# RWE_RETENTION_SCORED_DAYS=30             # score cache (regenerable)
# RWE_RETENTION_ANALYTICS_DAYS=180         # product-analytics events
# RWE_RETENTION_REC_EVENT_DAYS=365         # rec surface/open events (Open-Mindedness input)
# RWE_RETENTION_SNAPSHOTS_PER_USER=500     # report-trend history per user
# RWE_RETENTION_NOTIFICATIONS_PER_USER=200 # settled inbox history (unseen rows are never pruned)
# RWE_RETENTION_BATCH_LIMIT=5000           # max rows deleted per table per pass (keeps locks short)
# --- local backup retention (deploy/ops/prune-backups.sh, hourly cron) ---------------------------
# BACKUP_KEEP_HOURLY=12                    # every backup from the last N hours
# BACKUP_KEEP_DAILY=7                      # one per day for N days
# BACKUP_KEEP_WEEKLY=4                     # one per ISO week for N weeks
# BACKUP_KEEP_MONTHLY=0                    # 0 = long-tail depth lives in S3, not on the volume
# --- storage alerts (deploy/ops/monitor.sh, 5-min cron) ------------------------------------------
# DISK_WARN_PCT=75                         # alert when the data volume passes this
# DB_WARN_MB=2000                          # alert when the database passes this
# BACKUPS_WARN_MB=10000                    # alert when the backup directory passes this

# ── Web (Next.js / NextAuth / Google OAuth) ────────────────────────────────────────────────────────
NEXTAUTH_URL=https://hidden-view.com       # REQUIRED — exact https public URL (OAuth callback + cookies)
NEXTAUTH_SECRET=                           # REQUIRED — openssl rand -base64 32 (signs session JWTs)
GOOGLE_CLIENT_ID=                          # REQUIRED — Google OAuth Web client (only sign-in method)
GOOGLE_CLIENT_SECRET=                      # REQUIRED — Google OAuth Web client secret

# ── BA1 beta access control (invite-only allowlist) ────────────────────────────────────────────────
BETA_ACCESS_ENABLED=1                      # REQUIRED — 1 = gate ON (default in prod). Fail-closed if empty.
BETA_ALLOWLIST="you@example.com, teammate@example.com"   # REQUIRED — the Wave-0 emails (or @yourdomain.com)
# BETA_ALLOWLIST_FILE=/app/data/allowlist.txt            # (optional) file re-read per sign-in, no restart

# ── Backups ────────────────────────────────────────────────────────────────────────────────────────
BACKUP_KEEP=48                             # (optional) local backups to retain (~2 days hourly)
BACKUP_INTERVAL=3600                       # (optional) seconds between scheduler backups (hourly)
IH_S3_BUCKET=                              # REQUIRED for off-host — e.g. my-ih-beta-backups (no s3:// prefix)
# BACKUP_OFFHOST_CMD='aws s3 cp "$1" s3://my-ih-beta-backups/backups/'  # (optional) in-container shipment
                                           # (only if you add an AWS CLI to the image; default path ships
                                           #  from the HOST via deploy/ops/backup.sh + the instance IAM role)

# ── Monitoring & alerting (deploy/ops/monitor.sh 5-min cron, backup-offhost.sh) ────────────────────
IH_BASE_URL=http://127.0.0.1:8000          # (optional) engine base URL for local health probes
# IH_WEB_URL=https://hidden-view.com       # (optional) also probe the public web app
# ALERT_WEBHOOK — where unattended failures (health monitor + backup) are sent. UNSET = log-only (the
# stack never depends on it). SET = one concise JSON POST per problem, carrying BOTH "text" (Slack,
# Mattermost, Google Chat) and "content" (Discord), so a single URL works with either. Paste ONE of:
#   Slack   : https://hooks.slack.com/services/<T-id>/<B-id>/<token>   (from the Incoming Webhooks app)
#   Discord : https://discord.com/api/webhooks/<channel-id>/<token>    (Channel → Integrations → Webhooks)
#   Other   : any endpoint that accepts {"text": "..."} or {"content": "..."} (e.g. an SNS/Lambda proxy)
# See docs/PRODUCTION_ENVIRONMENT.md → "Alerting" for setup steps and a live-test command.
ALERT_WEBHOOK=                             # RECOMMENDED before wider launch — empty = health/backup log-only
