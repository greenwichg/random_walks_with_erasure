# Production environment TEMPLATE for the AWS EC2 closed beta (Wave 0). DEPLOYMENT-ONLY.
#
#   cp deploy/.env.production.example deploy/.env
#   $EDITOR deploy/.env        # fill every REQUIRED value below
#   chmod 600 deploy/.env      # secrets — owner-read-only
#
# This file is COMMITTED and MUST stay secret-free (placeholders only). The filled-in deploy/.env is
# git-ignored (see .gitignore). deploy/docker-compose.aws.yml reads these via ${VAR}; the host-side
# ops scripts (deploy/ops/*) read the same file. Values with a real default are marked (optional).
#
# Generate strong secrets with:  openssl rand -base64 32

# ── Domain & TLS (Caddy) ───────────────────────────────────────────────────────────────────────────
APP_DOMAIN=hidden-view.com                 # REQUIRED — apex served; www.<domain> redirects to it
ACME_EMAIL=ops@hidden-view.com             # REQUIRED — Let's Encrypt account email (expiry notices)

# ── Host data directory (bind-mounted to /app/data; holds the SQLite DB + backups) ─────────────────
IH_DATA_DIR=/opt/ih/data                   # (optional) default /opt/ih/data — created by bootstrap-ec2.sh
IH_DATA_MOUNT=0                            # 0 = data on the ROOT EBS volume (default, no separate mount).
                                           # 1 = data on a DEDICATED EBS volume mounted at IH_DATA_DIR:
                                           #     deploy refuses to start unless it is actually mounted, so a
                                           #     boot-before-mount race can't create a fresh EMPTY database.

# ── Engine (FastAPI) — fail-closed production auth ─────────────────────────────────────────────────
RWE_ENV=production                         # REQUIRED — enables fail-closed auth on both tiers
RWE_INTERNAL_SECRET=                       # REQUIRED — openssl rand -base64 32; IDENTICAL on api + web
RWE_DB_URL=sqlite:////app/data/ih_beta.db  # (optional) persistent DB path on the mounted volume
RWE_BACKEND_URL=http://api:8000            # (optional) web → engine origin on the Docker network

# ── Feature flags (engine) ─────────────────────────────────────────────────────────────────────────
RWE_COACH_V2=0                             # (optional) 1 = M6 coach v2 (intent-routed replies, weekly
                                           #   recap, trigger-ladder greeting) for MEASURED readers.
                                           #   0 = v1 grounded narrator (default). Demo path is always v1.

# ── GDELT ingestion (keyless second source; adapter already registered) — CONTROLLED TRIAL ──────────
# Wired but DISABLED by default. Enable a controlled trial per docs/GDELT_TRIAL_RUNBOOK.md. GDELT is
# high-volume + mostly unknown-outlet: those articles stay SEARCHABLE but are NOT recommendable (no-lean
# rows drop from the recommendation corpus — docs/CORPUS_ARCHITECTURE.md). Set RETENTION before enabling.
RWE_GDELT_ENABLED=0                         # 1 = poll GDELT (keyless). Default 0 (off).
# RWE_GDELT_QUERY=                          # (optional) override the built-in topic query; unset = default
RWE_GDELT_MAX_ARTICLES=25                   # per-poll cap (adapter default 75) — conservative
RWE_GDELT_POLL_INTERVAL=1800               # seconds between polls (adapter default 900) — 30 min, conservative
RWE_GDELT_GKG=1                             # GKG event-geography enricher (keyless) — the supply behind
                                           #   the event-location Country filter. ON at launch; set 0 to
                                           #   kill (pickers then stay empty — honest, never wrong).
# RWE_GDELT_GKG_INTERVAL=900               # (optional) seconds between GKG cycles; GKG publishes every 15 min
# RWE_GDELT_GKG_WINDOWS=4                  # (optional) steady-state 15-min windows per cycle (default 4 = 1 h).
# RWE_GDELT_GKG_BACKFILL_WINDOWS=96        # (optional) cold-start depth, AUTOMATIC on the first cycle over a
                                           #   barely-located catalog (default 96 = 24 h; 0 = disable).
# RWE_GDELT_GKG_BACKFILL_THRESHOLD=25       # (optional) "barely located" = fewer stored event rows than this.
RWE_RETENTION_MAX_COUNT=0                   # 0 = retention OFF (unbounded). REQUIRED non-zero (e.g. 20000)
                                           #   whenever RWE_GDELT_ENABLED=1 — bounds catalog/DB/backups.

# ── Web (Next.js / NextAuth / Google OAuth) ────────────────────────────────────────────────────────
NEXTAUTH_URL=https://hidden-view.com       # REQUIRED — exact https public URL (OAuth callback + cookies)
NEXTAUTH_SECRET=                           # REQUIRED — openssl rand -base64 32 (signs session JWTs)
GOOGLE_CLIENT_ID=                          # REQUIRED — Google OAuth Web client (only sign-in method)
GOOGLE_CLIENT_SECRET=                      # REQUIRED — Google OAuth Web client secret

# ── BA1 beta access control (invite-only allowlist) ────────────────────────────────────────────────
BETA_ACCESS_ENABLED=1                      # REQUIRED — 1 = gate ON (default in prod). Fail-closed if empty.
BETA_ALLOWLIST="you@example.com, teammate@example.com"   # REQUIRED — the Wave-0 emails (or @yourdomain.com)
# BETA_ALLOWLIST_FILE=/app/data/allowlist.txt            # (optional) file re-read per sign-in, no restart

# ── Backups ────────────────────────────────────────────────────────────────────────────────────────
BACKUP_KEEP=48                             # (optional) local backups to retain (~2 days hourly)
BACKUP_INTERVAL=3600                       # (optional) seconds between scheduler backups (hourly)
IH_S3_BUCKET=                              # REQUIRED for off-host — e.g. my-ih-beta-backups (no s3:// prefix)
# BACKUP_OFFHOST_CMD='aws s3 cp "$1" s3://my-ih-beta-backups/backups/'  # (optional) in-container shipment
                                           # (only if you add an AWS CLI to the image; default path ships
                                           #  from the HOST via deploy/ops/backup.sh + the instance IAM role)

# ── Monitoring & alerting (deploy/ops/monitor.sh 5-min cron, backup-offhost.sh) ────────────────────
IH_BASE_URL=http://127.0.0.1:8000          # (optional) engine base URL for local health probes
# IH_WEB_URL=https://hidden-view.com       # (optional) also probe the public web app
# ALERT_WEBHOOK — where unattended failures (health monitor + backup) are sent. UNSET = log-only (the
# stack never depends on it). SET = one concise JSON POST per problem, carrying BOTH "text" (Slack,
# Mattermost, Google Chat) and "content" (Discord), so a single URL works with either. Paste ONE of:
#   Slack   : https://hooks.slack.com/services/<T-id>/<B-id>/<token>   (from the Incoming Webhooks app)
#   Discord : https://discord.com/api/webhooks/<channel-id>/<token>    (Channel → Integrations → Webhooks)
#   Other   : any endpoint that accepts {"text": "..."} or {"content": "..."} (e.g. an SNS/Lambda proxy)
# See docs/PRODUCTION_ENVIRONMENT.md → "Alerting" for setup steps and a live-test command.
ALERT_WEBHOOK=                             # RECOMMENDED before wider launch — empty = health/backup log-only
