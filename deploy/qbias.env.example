# Production reference = Qbias. Source this (or set these vars) to run the engine on the real
# AllSides corpus instead of the synthetic default. See docs/QBIAS_MIGRATION.md for the one-time
# download + preprocessing (prepare_qbias.py) that produces data/qbias_clean.csv.
#
#   python examples/prepare_qbias.py --in data/qbias_raw.csv --out data/qbias_clean.csv
#   set -a; . deploy/qbias.env.example; set +a
#   python examples/api_fastapi.py --port 8000
#
# prepare_qbias.py also writes baseline register/emotion sidecars next to the cleaned CSV
# (data/qbias_clean.register.csv, data/qbias_clean.emotion.csv). Pointing the engine at them
# makes the reference population carry the SAME headline enrichment as ingested reads, so
# Reporting Ratio / Emotional Balance percentiles compare like-with-like.

RWE_PROFILE=qbias
RWE_QBIAS=data/qbias_clean.csv

# Aligned population enrichment (baseline register/emotion, from prepare_qbias). Omit these to
# fall back to the simulator's synthetic enrichment.
RWE_REGISTER_CSV=data/qbias_clean.register.csv
RWE_EMOTION_CSV=data/qbias_clean.emotion.csv

# Pin the simulated-population build so every reader's percentile is reproducible across
# restarts/deploys. Changing any of these re-draws the population and shifts scores — treat them
# as release-pinned config, not per-run knobs.
RWE_SEED=0
RWE_N_USERS=1500
RWE_MAX_ITEMS=3000

# In any shared/production deployment also set the trust-boundary + auth secrets (not Qbias-
# specific): RWE_INTERNAL_SECRET, NEXTAUTH_SECRET, GOOGLE_CLIENT_ID/SECRET, RWE_BACKEND_URL.

# Durable store (SQLite). Default is data/ih_beta.db beside the repo; in production point it at a
# file on a PERSISTENT VOLUME — production refuses to start on an in-memory or /tmp path. Back up
# with `python examples/db_backup.py backup`; RWE_BACKUP_DIR sets where backups are written.
# RWE_DB_URL=sqlite:////app/data/ih_beta.db
# RWE_BACKUP_DIR=/app/data/backups

# Browser CORS for the engine. Default is `*` in dev, locked (none) in production — the engine is
# internal and the web tier calls it server-to-server. Set only if a browser must call it directly.
# RWE_CORS_ORIGINS=https://app.example.com
