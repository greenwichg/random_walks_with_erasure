{
  // Extends nothing yet — `expo/tsconfig.base` arrives with the Expo install. What is fixed now is
  // the part that outlives any template: strict on, and @ih/core resolved through the workspace
  // rather than a relative path into a sibling directory.
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
