{
  // Expo's base config sets the JSX runtime, the module resolution and the React Native types.
  // Everything below it is Hidden View's own.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // @ih/core and this app both write relative imports with an explicit `.ts`, which is what lets
    // `node --test` resolve them without a bundler — the convention the repo has followed since
    // web/lib/engine-identity.ts. Metro and tsc both accept it; this flag is what stops tsc from
    // treating it as an error.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
