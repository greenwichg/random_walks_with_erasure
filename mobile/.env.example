# Hidden View mobile — build-time configuration.
#
# Copy to `mobile/.env` (gitignored) and fill in. Every value here is a PUBLIC identifier: OAuth
# client ids have no confidential half for native clients, and the API host is the address of a
# public website. They are kept out of git because they differ per deployment, not because they are
# credentials — the one credential this app holds is the bearer token, minted at runtime and stored
# in the platform keystore.
#
# `npm run verify:config --workspace @ih/mobile` checks these WITHOUT printing them.

# The deployment. A native app has no origin of its own, so this is required.
# NOTE: on a real device `localhost` resolves to the PHONE. Use the deployment, or your machine's
# LAN address if you are pointing a dev build at a local web server.
EXPO_PUBLIC_API_BASE_URL=https://hidden-view.com

# --- Google OAuth client ids, one per platform -------------------------------------------------
# Google issues a SEPARATE client per platform and a native ID token's `aud` claim is the NATIVE
# client id, never the web one. The server must trust the matching values via GOOGLE_IOS_CLIENT_ID /
# GOOGLE_ANDROID_CLIENT_ID (web/.env.example), or POST /api/auth/mobile answers 500 not-configured.
#
# Create at: console.cloud.google.com → APIs & Services → Credentials → Create credentials
#            → OAuth client ID
#
#   iOS      Application type "iOS". Bundle ID: com.hiddenview.app
#   Android  Application type "Android". Package name: com.hiddenview.app
#            AND the SHA-1 fingerprint of the signing certificate — see below.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# The existing WEB client (the one NextAuth already uses). Expo's auth proxy issues against it during
# development, so sign-in works in a dev build before the native clients exist.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- EAS ---------------------------------------------------------------------------------------
# Normally leave this EMPTY. The project id is hardcoded in app.config.ts, because EAS reads it out
# of the resolved config and evaluates that config without loading this file — a value set only here
# is invisible to every `eas` command. Set it only to build under a different EAS account.
EXPO_PUBLIC_EAS_PROJECT_ID=
