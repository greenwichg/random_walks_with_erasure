# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# Data / artifacts (datasets are not redistributed)
data/raw/
data/*.dat
data/*.csv
*.npz
*.npy

# Product persistence (SQLite beta store; created at runtime under data/)
*.db
*.db-journal
*.db-wal
*.db-shm
# Backup / restore runtime artifacts (examples/db_backup.py)
backups/
*.db.pre-restore
*.restore.tmp

# Generated run/eval outputs (created at repo root by examples/*.py; not deliverables).
# Root-anchored (leading /) so they never shadow tracked files like
# examples/data/subreddit_lean.csv.
/eval_mind.csv
/results*.csv
/sweep*.csv
/*_results.csv
/movielens_rq2.csv
/lean*.csv
/register.csv
/emotion.csv
/label_*.tsv
/axis*.png
/polito_axis.png
/health_report.html

# Deployment secrets — the filled-in production env is NEVER committed. The tracked, secret-free
# templates (deploy/.env.production.example, deploy/qbias.env.example) do not match these patterns.
/deploy/.env
/deploy/.env.local
# Timestamped backups an operator makes before editing the env-file. These are FULL COPIES of the
# secrets, and the patterns above are exact paths rather than a glob, so without these lines a
# backup lands as an untracked file inside a repo the deploy scripts run git against. Named
# narrowly on purpose: a blanket `/deploy/.env.*` would also match the tracked, secret-free
# .env.production.example template.
/deploy/.env.bak.*
/deploy/.env.*.bak

# OS / editor
.DS_Store
.idea/
.vscode/

# Metric Validation Pipeline — isolated, local-only run history (Stage 10)
examples/metric_pipeline/.runs.jsonl

# Recommendation Validation Pipeline — isolated, local-only run history (21d)
examples/rec_pipeline/.runs.jsonl

# Metric Validation notebook — local run outputs (exports + throwaway demo DB)
metric_validation.json
metric_validation.csv
metric_validation.html
data/metric_validation_demo.db

# Browser Extension Playground notebook — runtime artifacts its Section 2 creates at the
# repo root when the notebook runs inside a checkout (helper module, state, service logs)
/_playground_ui.py
/playground_state.json
/engine.log
/web.log
/cf.log
/cloudflared

# Terraform — remote state lives in S3, never in git. The provider lock
# (.terraform.lock.hcl) is intentionally NOT ignored; it is committed.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# tfvars can hold secrets — ignore by default; commit *.tfvars.example instead.
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.deploy-stage-state

# Playwright artifacts. The suite writes these under web/ (see web/.gitignore), but running
# `npx playwright test` from the repo root instead of from web/ drops them here — which is how a
# stray test-results/ once turned up untracked at the top level.
/test-results/
/playwright-report/

# npm workspaces. The install is hoisted to the repo root now (web/.gitignore's `/node_modules` was
# rooted to web/ and stopped covering it), and npm may still create nested trees for a package whose
# dependency cannot hoist.
/node_modules
packages/*/node_modules
mobile/node_modules

# The Expo app's build output.
/mobile/.expo/
/mobile/android/
/mobile/ios/

# Mobile build-time configuration. Public identifiers, but per-deployment: see mobile/.env.example.
# The bearer token is never here — it is minted at runtime into the platform keystore.
/mobile/.env
/mobile/.env.local
