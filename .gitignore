# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# Data / artifacts (datasets are not redistributed)
data/raw/
data/*.dat
data/*.csv
*.npz
*.npy

# Product persistence (SQLite beta store; created at runtime under data/)
*.db
*.db-journal
*.db-wal
*.db-shm
# Backup / restore runtime artifacts (examples/db_backup.py)
backups/
*.db.pre-restore
*.restore.tmp

# Generated run/eval outputs (created at repo root by examples/*.py; not deliverables).
# Root-anchored (leading /) so they never shadow tracked files like
# examples/data/subreddit_lean.csv.
/eval_mind.csv
/results*.csv
/sweep*.csv
/*_results.csv
/movielens_rq2.csv
/lean*.csv
/register.csv
/emotion.csv
/label_*.tsv
/axis*.png
/polito_axis.png
/health_report.html

# Deployment secrets — the filled-in production env is NEVER committed. The tracked, secret-free
# templates (deploy/.env.production.example, deploy/qbias.env.example) do not match these patterns.
/deploy/.env
/deploy/.env.local

# OS / editor
.DS_Store
.idea/
.vscode/

# Metric Validation Pipeline — isolated, local-only run history (Stage 10)
examples/metric_pipeline/.runs.jsonl

# Recommendation Validation Pipeline — isolated, local-only run history (21d)
examples/rec_pipeline/.runs.jsonl

# Metric Validation notebook — local run outputs (exports + throwaway demo DB)
metric_validation.json
metric_validation.csv
metric_validation.html
data/metric_validation_demo.db

# Browser Extension Playground notebook — runtime artifacts its Section 2 creates at the
# repo root when the notebook runs inside a checkout (helper module, state, service logs)
/_playground_ui.py
/playground_state.json
/engine.log
/web.log
/cf.log
/cloudflared
