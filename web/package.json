{
  "name": "information-health",
  "version": "0.1.0",
  "private": true,
  "description": "Information Health — a reading-diet intelligence product. Frontend for the RWE recommender + Information Health Report backend.",
  "scripts": {
    "dev": "next dev",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build": "npm run check:i18n && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/i18n-core.test.ts lib/rec-presentation.test.ts lib/history-insights.test.ts lib/hero-copy.test.ts lib/coach-presentation.test.ts lib/notifications.test.ts lib/analysis-presentation.test.ts lib/settings-diff.test.ts lib/engine-fallback.test.ts lib/coverage.test.ts lib/beta-access.test.ts lib/home.test.ts lib/story-timeline.test.ts lib/countries.test.ts",
    "build:e2e": "NEXT_PUBLIC_DEV_LOGIN=1 next build",
    "e2e": "npm run build:e2e && playwright test",
    "e2e:run": "playwright test",
    "e2e:report": "playwright show-report .e2e-tmp/report"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.59.16",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.11",
    "lucide-react": "^0.454.0",
    "next": "14.2",
    "next-auth": "^4.24.14",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.16.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
