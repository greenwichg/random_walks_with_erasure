# --- Real Python engine (server-side proxy target) --------------------------
# The Next.js /api/* routes proxy to the Information Health engine
# (examples/api_server.py) and fall back to the built-in mock automatically
# when it is unreachable. Point this at the running engine to go live.
# Start the engine from the repo root:  python examples/api_server.py
RWE_BACKEND_URL=http://127.0.0.1:8000
# Optional: how long (ms) to wait for the engine before falling back to mock.
RWE_BACKEND_TIMEOUT_MS=6000
# Whether engine-backed routes (report/recommendations/coach) may serve mock
# data when the engine is unreachable. Defaults ON in development, OFF in
# production (a reader gets a 503, never fabricated health numbers). Force with
# "true"/"false".
RWE_ALLOW_MOCK_FALLBACK=

# --- Browser API base (advanced) --------------------------------------------
# Origin the browser Axios client prefixes to /api/*. Leave EMPTY to use this
# app's own Next.js API routes (the proxy above). Only set this to call a
# different API origin directly from the browser.
NEXT_PUBLIC_API_BASE_URL=

# --- Authentication (NextAuth / Google OAuth) -------------------------------
# Google sign-in for the closed beta. Create an OAuth 2.0 Client ID (type "Web
# application") in the Google Cloud Console and register the callback URL:
#   http://localhost:3000/api/auth/callback/google   (plus your production URL)
# Live sign-in needs these set; without them the app still builds and the engine
# serves the demo reader.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret used to sign session JWTs. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical URL of this app, used for OAuth callbacks (dev default shown).
NEXTAUTH_URL=http://localhost:3000

# --- Native (Android / iOS) sign-in -----------------------------------------
# The Expo app signs in with Google natively and posts the resulting ID TOKEN to
# POST /api/auth/mobile, which verifies it against Google's public keys, runs the
# same closed-beta allowlist the web sign-in runs, and returns a Hidden View bearer
# token. No secret ever reaches the phone: native OAuth clients have none.
#
# Google issues a SEPARATE client id per platform, and a native ID token's `aud`
# claim is the NATIVE client id — never the web one above. So these are additional
# values, not alternatives, and the endpoint trusts the union of the three.
#
# FAIL-CLOSED: with none of these set, /api/auth/mobile returns 500 `not-configured`
# and mints nothing. That is deliberate — accepting any audience "until it is
# configured" is how a placeholder reaches production, and an unchecked audience
# would let any developer's Google app sign its users into Hidden View.
#
# Creating them (Google Cloud Console -> Credentials -> Create OAuth client ID):
#   iOS      needs the bundle identifier. No client secret.
#   Android  needs the package name AND the SHA-1 fingerprint of the signing
#            certificate. Register BOTH the debug keystore and the EAS release
#            keystore (`eas credentials`) — a missing fingerprint fails sign-in on
#            the device with a bare DEVELOPER_ERROR and no mention of the cause.
# While the OAuth consent screen is in "Testing", only listed test users can sign in
# (max 100). That is a SECOND gate, independent of BETA_ALLOWLIST: a tester missing
# from either one is refused.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Web <-> engine trust (server-to-server) --------------------------------
# Shared secret the web tier signs engine calls with (sent as X-IH-Auth). Set the
# SAME value here and as RWE_INTERNAL_SECRET on the engine to authenticate the link,
# so only this app can attribute a request to a user. Empty in local dev (the engine
# then trusts localhost calls); REQUIRED once RWE_ENV=production (see below).
RWE_INTERNAL_SECRET=

# --- Deployment mode --------------------------------------------------------
# Set to "production" for a real, internet-facing deployment. It is the cross-tier
# production switch: the engine reads the same variable to FAIL CLOSED (reject any
# per-user request without RWE_INTERNAL_SECRET, and refuse to start if that secret
# is missing), and the web app disables the dev demo-login. Leave EMPTY for local
# development and the Colab demo (both run fail-open with zero extra config).
#
# With RWE_ENV=production the web app VALIDATES its configuration at startup and
# refuses to boot if anything required is missing: NEXTAUTH_SECRET, RWE_INTERNAL_SECRET,
# RWE_BACKEND_URL, and a complete Google OAuth setup (GOOGLE_CLIENT_ID +
# GOOGLE_CLIENT_SECRET + NEXTAUTH_URL). See DEPLOYMENT.md → "Startup validation".
RWE_ENV=

# --- Browser security headers -----------------------------------------------
# The app ships a strict Content-Security-Policy + hardening headers (see DEPLOYMENT.md →
# "Browser security"), baked at BUILD time. Usually leave these unset.
# RWE_CSP=            # override the entire CSP string (advanced)
# RWE_DISABLE_CSP=    # set to 1 to drop only the CSP header (escape hatch); other headers stay
